                                                           Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" Style="{StaticResource HotkeyKey}">
                                                    <TextBlock x:Name="hotKeyRetryTranslate" Text="ALT + T" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextBrush}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource HotkeyItem}" MinWidth="220">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=Strings[Lbl_SelectExcludeRegion]}"
                                                           Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" Style="{StaticResource HotkeyKey}">
                                                    <TextBlock x:Name="hotKeyToggleExcludeRegions" Text="ALT + X" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextBrush}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <!-- Area hotkeys -->
                                        <Border Style="{StaticResource HotkeyItem}" MinWidth="180">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=Strings[Lbl_SelectArea1]}"
                                                           Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" Style="{StaticResource HotkeyKey}">
                                                    <TextBlock x:Name="hotKeyArea1" Text="ALT + 1" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextBrush}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource HotkeyItem}" MinWidth="180">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=Strings[Lbl_SelectArea2]}"
                                                           Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" Style="{StaticResource HotkeyKey}">
                                                    <TextBlock x:Name="hotKeyArea2" Text="ALT + 2" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextBrush}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource HotkeyItem}" MinWidth="180">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=Strings[Lbl_SelectArea3]}"
                                                           Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" Style="{StaticResource HotkeyKey}">
                                                    <TextBlock x:Name="hotKeyArea3" Text="ALT + 3" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextBrush}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource HotkeyItem}" MinWidth="180">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=Strings[Lbl_SelectArea4]}"
                                                           Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" Style="{StaticResource HotkeyKey}">
                                                    <TextBlock x:Name="hotKeyArea4" Text="ALT + 4" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextBrush}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource HotkeyItem}" MinWidth="180">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=Strings[Lbl_SelectArea5]}"
                                                           Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" Style="{StaticResource HotkeyKey}">
                                                    <TextBlock x:Name="hotKeyArea5" Text="ALT + 5" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextBrush}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <Border Name="FooterBorder" Grid.Row="2" Background="{DynamicResource SurfaceBrush}" Padding="16,10" CornerRadius="0,0,12,12"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=Strings[Lbl_Language_Interface]}" Target="{Binding ElementName=languageSelector}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="languageSelector" Width="170" Height="30" Style="{StaticResource ThemedComboBox}" SelectionChanged="LanguageSelector_SelectionChanged"></ComboBox>
                    </StackPanel>
                    <TextBlock x:Name="AppVersion" Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Grid>
</Window>
