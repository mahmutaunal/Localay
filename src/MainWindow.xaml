                                                    <TextBlock x:Name="hotKeySwapLanguages" Text="ALT + V" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextBrush}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource HotkeyItem}" MinWidth="220">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=Strings[Lbl_ClearAllAreas]}"
                                                           Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
