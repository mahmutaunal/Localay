<Window x:Class="AlpWareStudio.Localay.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AlpWareStudio.Localay"
        Title="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=Strings[LogWindow_Title]}"
        Width="800" Height="600"
        MinWidth="400" MinHeight="300"
        Background="{DynamicResource BgBrush}"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True"
        Topmost="False">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource Surface2Brush}" Padding="10,8">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" 
                          Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=Strings[LogWindow_Header]}" 
                          Foreground="{DynamicResource TextBrush}"
                          FontSize="14" 
                          FontWeight="SemiBold"
                          VerticalAlignment="Center"/>
                
                    <CheckBox x:Name="contentDiagnosticsCheckBox"
                             Content="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=Strings[Chk_ContentDiagnostics]}"
                             Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="0,8,0,0" Grid.Row="1" Grid.ColumnSpan="2"
                             Checked="ContentDiagnostics_Changed" Unchecked="ContentDiagnostics_Changed"/>
                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=Strings[Log_TechnicalHint]}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <CheckBox x:Name="autoScrollCheckBox" 
                             Content="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=Strings[LogWindow_Chk_AutoScroll]}" 
                             Foreground="{DynamicResource TextBrush}"
                             IsChecked="True"
                             VerticalAlignment="Center"
                             Margin="0,0,15,0"/>
                    
                    <Button x:Name="clearButton" 
                           Content="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=Strings[LogWindow_Btn_Clear]}" 
                           Padding="10,4" 
                           Margin="0,0,5,0"
                           Background="{DynamicResource Surface3Brush}"
                           Foreground="{DynamicResource TextBrush}"
                           BorderThickness="1" 
                           BorderBrush="{DynamicResource BorderBrush}"
                           Click="ClearButton_Click"/>
                    
                    <Button x:Name="copyAllButton" 
                           Content="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=Strings[LogWindow_Btn_CopyAll]}" 
                           Padding="10,4"
                           Background="{DynamicResource Surface3Brush}"
                           Foreground="{DynamicResource TextBrush}"
                           BorderThickness="1" 
                           BorderBrush="{DynamicResource BorderBrush}"
                           Click="CopyAllButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Log Content -->
        <Border Grid.Row="1" 
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,1">
            <ScrollViewer x:Name="logScrollViewer" 
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto">
                <TextBox x:Name="logTextBox"
                        Background="Transparent"
                        Foreground="{DynamicResource TextBrush}"
                        FontFamily="Consolas, Courier New"
                        FontSize="12"
                        IsReadOnly="True"
                        TextWrapping="NoWrap"
                        BorderThickness="0"
                        Padding="10"
                        VerticalAlignment="Stretch"
                        HorizontalAlignment="Stretch"
                        AcceptsReturn="True"
                        TextChanged="LogTextBox_TextChanged"/>
            </ScrollViewer>
        </Border>
        
        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource Surface2Brush}" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" 
                          x:Name="statusText"
                          Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=Strings[LogWindow_Status_Ready]}" 
                          Foreground="{DynamicResource TextBrush}"
                          FontSize="11"/>
                
                <TextBlock Grid.Column="1" 
                          x:Name="lineCountText"
                          Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=Strings[LogWindow_Status_Lines]}" 
                          Foreground="{DynamicResource TextBrush}"
                          FontSize="11"/>
            </Grid>
        </Border>
    </Grid>
</Window>
