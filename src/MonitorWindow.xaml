<Window x:Class="AlpWareStudio.Localay.MonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AlpWareStudio.Localay"
        mc:Ignorable="d"
        Title="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=Strings[Monitor_Title]}"
        Height="600" Width="800"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        BorderThickness="0"
        BorderBrush="Red"
        Background="Transparent"  
        Icon="/assets/localay.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Control Panel -->
        <WrapPanel Grid.Row="0" Background="{DynamicResource Surface2Brush}" Margin="10,5,10,5" Visibility="Collapsed">
            <!-- Zoom Controls -->
            <Button x:Name="zoomOutButton" Content="-" Width="30" Margin="2" 
                    Click="ZoomOutButton_Click" Background="{DynamicResource Surface3Brush}" Foreground="{DynamicResource TextBrush}"/>
            <Button x:Name="zoomInButton" Content="+" Width="30" Margin="2" 
                    Click="ZoomInButton_Click" Background="{DynamicResource Surface3Brush}" Foreground="{DynamicResource TextBrush}"/>
            <TextBox x:Name="zoomTextBox" Width="60" Margin="2" Text="100" TextAlignment="Center"
                     VerticalContentAlignment="Center" Background="{DynamicResource Surface3Brush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource MutedBrush}"/>
                    
            <!-- Separator -->
            <Rectangle Width="1" Fill="{DynamicResource MutedBrush}" Margin="10,2" VerticalAlignment="Stretch"/>
            
            <!-- Hidden controls for settings synchronization -->
            <ComboBox x:Name="ocrMethodComboBox" Width="0" Height="0" Margin="0" Visibility="Collapsed" SelectedIndex="1">
                <ComboBoxItem Content="Windows OCR"/>
                <ComboBoxItem Content="OneOCR"/>
            </ComboBox>
            
            <CheckBox x:Name="autoTranslateCheckBox" IsChecked="True" Visibility="Collapsed"/>
            
            <TextBox x:Name="blockDetectionPowerTextBox" Width="0" Height="0" Margin="0" Visibility="Collapsed" 
                     Text="5" VerticalContentAlignment="Center"/>
            
            
            <!-- Status Text -->
            <TextBlock x:Name="statusText" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </WrapPanel>
        
        <!-- ScrollViewer for zooming and scrolling -->
        <ScrollViewer Grid.Row="1" x:Name="imageScrollViewer" Visibility="Collapsed"
              HorizontalScrollBarVisibility="Hidden" 
              VerticalScrollBarVisibility="Hidden"
              Background="{x:Null}">
            <Grid x:Name="imageContainer" Background="Transparent">
                <Image x:Name="captureImage" Stretch="None" Visibility="Collapsed"
                    Width="0" Height="0"
                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                    HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Canvas x:Name="textOverlayCanvas" Panel.ZIndex="1" IsHitTestVisible="False"/>
            </Grid>
        </ScrollViewer>
        
        <!-- Translation status as overlay -->
        <Border x:Name="translationStatusBorder" Grid.Row="1"
                Background="{DynamicResource Surface2Brush}"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="0,0,0,10"
                Padding="10,5"
                CornerRadius="5"
                BorderThickness="1"
                BorderBrush="{DynamicResource BorderBrush}"
                Visibility="Collapsed"
                Panel.ZIndex="10"
                IsHitTestVisible="False">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="translationStatusLabel" 
                              Foreground="{DynamicResource TextBrush}"
                              FontSize="14"
                              FontWeight="SemiBold"
                              Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=Strings[ChatBox_Status_WaitingTranslation]}"
                              VerticalAlignment="Center"
                              Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
