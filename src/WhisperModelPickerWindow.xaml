<Window x:Class="AlpWareStudio.Localay.WhisperModelPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AlpWareStudio.Localay"
        Title="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=Strings[Ttl_WhisperModelPicker]}"
        Height="520" Width="620"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Surface3Brush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=Strings[Lbl_WhisperModelPickerIntro]}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"/>

        <CheckBox x:Name="showEnglishOnlyCheckBox" Grid.Row="1"
                  Content="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=Strings[Chk_ShowEnglishOnlyModels]}"
                  Foreground="{DynamicResource TextBrush}"
                  Margin="0,0,0,8"
                  Checked="ShowEnglishOnlyCheckBox_Changed"
                  Unchecked="ShowEnglishOnlyCheckBox_Changed"/>

        <ListBox x:Name="modelListBox" Grid.Row="2"
                 Background="{DynamicResource Surface2Brush}"
                 Foreground="{DynamicResource TextBrush}"
                 BorderBrush="{DynamicResource BorderBrush}"
                 BorderThickness="1"
                 HorizontalContentAlignment="Stretch"
                 SelectionChanged="ModelListBox_SelectionChanged"
                 MouseDoubleClick="ModelListBox_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ShortName}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Badge}"
                                           Margin="8,0,0,0"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Detail}"
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SizeText}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,4,0"
                                   FontFamily="Consolas"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="diskWarningTextBlock" Grid.Row="3"
                   Margin="0,8,0,0"
                   FontSize="11"
                   FontStyle="Italic"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource DangerBrush}"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="downloadButton"
                    Content="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=Strings[Btn_Download]}"
                    IsEnabled="False"
                    Click="DownloadButton_Click"/>
            <Button Content="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=Strings[Btn_Close]}"
                    IsCancel="True"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
