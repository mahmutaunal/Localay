    <Compile Include="../../src/PreferenceCommit.cs" Link="PreferenceCommit.cs" />
    <Compile Include="../../src/PreferenceRules.cs" Link="PreferenceRules.cs" />
    <Compile Include="../../src/LocalizationManager.cs" Link="LocalizationManager.cs" />
