<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Localay</AssemblyName>
    <OutputPath>app</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <RootNamespace>AlpWareStudio.Localay</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <ApplicationIcon>media\AppIcon.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!--
      PublishSingleFile=true would bundle all managed DLLs (including
      Microsoft.ML.OnnxRuntime.dll) into a single Localay.exe (~190 MB).
      This breaks the ONNX Runtime native loader path on first launch and
      causes the app to crash when the user has tts_service=Supertonic.
      Multi-file self-contained publish keeps every DLL next to Localay.exe,
      which matches the layout that works for both `dotnet build` and
      `dotnet publish` outputs.
    -->
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Assembly metadata — helps AV heuristics identify the binary as legitimate -->
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Company>AlpWare Studio</Company>
    <Product>Localay</Product>
    <Authors>AlpWare Studio and Localay contributors</Authors>
    <Description>Real-time game localization for Windows</Description>
    <AssemblyTitle>Localay</AssemblyTitle>
    <Copyright>Copyright © 2026 AlpWare Studio. Based on RSTGameTranslation (GPL-3.0).</Copyright>

    <!-- Include PDB for deterministic builds — AV engines trust binaries with debug info -->
    <!-- Note: CsWinRT IIDOptimizer requires a separate PDB file, so use 'portable' not 'embedded' -->
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>

    <!-- Deterministic build — identical source always produces identical binary (improves AV trust) -->
    <Deterministic>true</Deterministic>

    <!-- Disable IL trimming to avoid AV heuristic false-positives from trimmed assemblies -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <AssemblyName>Localay.Debug</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.0.6" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.4" />
    <PackageReference Include="System.Management" Version="7.0.1" />
    <PackageReference Include="System.Speech" Version="9.0.9" />
    <PackageReference Include="Whisper.net" Version="1.9.0" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.0" />
    <PackageReference Include="Whisper.net.Runtime.Cuda.Windows" Version="1.9.0" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.0" />
  </ItemGroup>
  
  <ItemGroup>
    <Compile Include="src\**\*.cs" />
    <None Remove="src\**\*.xaml" />
    <ApplicationDefinition Include="src\App.xaml" />
    <Page Include="src\**\*.xaml" Exclude="src\App.xaml" />
    <None Include="app.manifest" />
  </ItemGroup>
  
  <ItemGroup>
    <Resource Include="media\AppIcon.ico" />
  </ItemGroup>

</Project>